# Copie este archivo como .env y llene los valores. El archivo .env nunca entra al repositorio.

# Base de datos en Render. Son dos usuarios distintos.
# Migraciones: el dueño de las tablas. Pegue aquí la "External Database URL" tal como la da Render.
BD_URL_MIGRACIONES=
# Aplicación: vitalia_api, sin privilegios de dueño.
BD_URL=

# Secreto con el que se resume la dirección de red de cada equipo. Una cadena larga al azar.
SESION_SECRETO=

# Dirección de las pantallas. En local, la de Vite.
SITIO_URL=http://localhost:5173

# Archivos en Cloudflare R2.
ARCHIVOS_DIRECCION=
ARCHIVOS_ESPACIO=vitalia-dev
ARCHIVOS_CLAVE_ID=
ARCHIVOS_CLAVE_SECRETA=

# Proveedor de IA: Qwen, región Singapur.
IA_DIRECCION=
IA_CLAVE=
IA_MODELO_RESPUESTAS=qwen3.7-plus
IA_MODELO_LECTURA=qwen3.5-ocr
