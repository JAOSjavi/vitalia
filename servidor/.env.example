# Copie este archivo como .env y llene los valores. El archivo .env nunca entra al repositorio.

# Base de datos. Son dos usuarios distintos. En local, la de Docker (docker-compose.yml);
# al publicar, la "External Database URL" de Render tal como la da Render.
# Migraciones: el dueño de las tablas.
BD_URL_MIGRACIONES=
# Aplicación: vitalia_api, sin privilegios de dueño.
BD_URL=

# Secreto con el que se resume la dirección de red de cada equipo. Una cadena larga al azar.
SESION_SECRETO=

# Dirección de las pantallas. En local, la de Vite.
SITIO_URL=http://localhost:5173

# Archivos en Cloudflare R2.
ARCHIVOS_DIRECCION=
ARCHIVOS_ESPACIO=vitalia-dev
# Mientras R2 no esté conectado, los archivos van a esta carpeta (por defecto servidor/.archivos).
ARCHIVOS_CARPETA=
ARCHIVOS_CLAVE_ID=
ARCHIVOS_CLAVE_SECRETA=

# Proveedor de IA: Qwen, región Singapur.
IA_DIRECCION=
IA_CLAVE=
IA_MODELO_RESPUESTAS=qwen3.7-plus
IA_MODELO_LECTURA=qwen-vl-ocr-2025-11-20
# Vectores de los fragmentos que busca el asistente (D-30). El tamaño debe coincidir con la
# columna fragmentos.vector de la base: si cambia, hace falta una migración y volver a indexar.
IA_MODELO_VECTORES=qwen3.7-text-embedding
IA_DIMENSIONES=1024
